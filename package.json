{
  "name": "midwestmackey",
  "version": "1.0.0",
  "description": "Midwest Mackey",
  "repository": {
    "type": "git",
    "url": "https://github.com/midwest-mackey/midwest-mackey-website.git"
  },
  "main": "index.html",
  "scripts": {
    "ng": "ng",
    "start:api": "docker compose up --build",
    "start:ui": "ng serve --host 0.0.0.0 --port 4200 --disable-host-check",
    "start": "npm run start:api & npm run start:ui",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "preci:build": "node scripts/set-version.js",
    "ci:build": "npm run preci:build && ng build --configuration production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "test:api": "node --experimental-vm-modules backend/tests/webworks.routes.test.mjs",
    "test:all": "npm test -- --runInBand && npm run test:api"
  },
  "private": true,
  "dependencies": {
    "@angular-package/sass": "^0.19.0-beta",
    "@angular/animations": "^20.3.33",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "fast-average-color": "^9.6.0",
    "node-vibrant": "^4.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.39",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/localize": "^20.3.33",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^15.0.3",
    "jiti": "^2.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "@jest/globals": "^30.5.2"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.6",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
